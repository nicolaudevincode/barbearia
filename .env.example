# Copie este arquivo para ".env" e preencha (nunca suba o .env para o GitHub).

# Chave que protege a sessão do login. Deixe vazio para o sistema gerar sozinho.
SECRET_KEY=

# Primeiro usuário do painel (criado na primeira execução, se o banco estiver vazio)
ADMIN_USUARIO=gabriel
ADMIN_SENHA=

# 1 = cookie só trafega em HTTPS (use 1 em produção com domínio)
COOKIE_SECURE=0

# Caminho do banco (deixe vazio para instance/barbearia.db)
BARBEARIA_DB=

# Porta do servidor local
PORT=8000